{
  "spec_version": "0.1",
  "workbook": {
    "name": "MCP Authoring Smoke Test",
    "description": "compiler smoke test"
  },
  "data_sources": [
    {
      "id": "sites",
      "type": "csv",
      "path": "/absolute/path/to/your/data.csv"
    }
  ],
  "calculated_fields": [
    {
      "name": "Readiness Band",
      "data_source": "sites",
      "datatype": "string",
      "formula": "IF [Readiness Score] >= 70 THEN \"High\" ELSEIF [Readiness Score] >= 50 THEN \"Medium\" ELSE \"Low\" END"
    }
  ],
  "worksheets": [
    {
      "name": "Readiness by Site",
      "template": "bar",
      "data_source": "sites",
      "rows": [
        "Site Name"
      ],
      "columns": [
        {
          "field": "Readiness Score",
          "aggregation": "Sum"
        }
      ],
      "color": "Readiness Band",
      "label": {
        "field": "Readiness Score",
        "aggregation": "Sum"
      },
      "tooltips": [
        {
          "field": "Charger Count",
          "aggregation": "Sum"
        },
        "State"
      ],
      "filters": [
        "Status"
      ],
      "title": "EV Charging Readiness by Site",
      "subtitle": "Synthetic validation data"
    },
    {
      "name": "Cost vs Sessions",
      "template": "scatter",
      "data_source": "sites",
      "rows": [
        {
          "field": "Annual Sessions",
          "aggregation": "Sum"
        }
      ],
      "columns": [
        {
          "field": "Estimated Cost",
          "aggregation": "Sum"
        }
      ],
      "color": "Status",
      "title": "Cost vs Annual Sessions"
    },
    {
      "name": "Site Detail",
      "template": "text_table",
      "data_source": "sites",
      "rows": [
        "Site Name",
        "State"
      ],
      "columns": [
        {
          "field": "Charger Count",
          "aggregation": "Sum"
        }
      ],
      "title": "Site Detail Table"
    }
  ],
  "output": {
    "directory": "/absolute/path/to/your/output/directory",
    "package_twbx": true
  }
}